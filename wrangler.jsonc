{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jamtrackshub",
  "compatibility_date": "2026-07-21",
  "main": "./worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "SUBSCRIBERS_DB",
      "database_name": "jamtrackshub_subscribers",
      "database_id": "9fbeaf79-817b-47fa-afc2-15f37712df46"
    }
  ]
}
